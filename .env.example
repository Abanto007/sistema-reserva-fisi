# Copia de referencia. NO pongas aquí datos reales.
# `pnpm convex dev` crea automáticamente el archivo .env.local con estas dos variables
# (queda fuera de git gracias a .gitignore).
CONVEX_DEPLOYMENT=dev:nombre-de-tu-deployment
VITE_CONVEX_URL=https://nombre-de-tu-deployment.convex.cloud

# Variables del lado de Convex (se configuran con `pnpm convex env set NOMBRE valor`,
# no en este archivo). Se usarán en la Fase 1 para el envío de correos:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
# Si no se configuran, se usa una cuenta de prueba de Ethereal Email.
